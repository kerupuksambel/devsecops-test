<mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid black arrow: request or egress path&lt;br&gt;Blue arrow: CI/CD path&lt;br&gt;Dashed arrow: AWS API / management / audit traffic&lt;br&gt;Green box: public subnet&lt;br&gt;Teal box: private subnet&lt;br&gt;Red helmet icon: IAM role (short-lived credentials only)&lt;br&gt;&lt;br&gt;&lt;b&gt;No long-lived credentials anywhere:&lt;/b&gt;&lt;br&gt;CI uses GitHub OIDC, ECS uses task roles,&lt;br&gt;the app uses IAM database authentication." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0B0B0;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="290" height="165" as="geometry"/></mxCell>
